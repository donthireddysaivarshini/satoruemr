      <bind nodeset="/data/screened_by_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/g_rev/review_date" type="date" required="true()"/>
      <setvalue ref="/data/g_rev/review_date" value="today()" event="odk-instance-first-load"/>
      <bind nodeset="/data/g_rev/alive" type="string" required="true()"/>
      <bind nodeset="/data/g_rev/caregiver_reported_trend" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_1" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_2" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_3" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_4" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_5" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_6" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_7" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_8" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/ad8_total" type="string" calculate="number( /data/g_rev/ad8_1 ) + number( /data/g_rev/ad8_2 ) + number( /data/g_rev/ad8_3 ) + number( /data/g_rev/ad8_4 ) + number( /data/g_rev/ad8_5 ) + number( /data/g_rev/ad8_6 ) + number( /data/g_rev/ad8_7 ) + number( /data/g_rev/ad8_8 )"/>
      <bind nodeset="/data/g_rev/phq2_1" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/phq2_2" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/phq2_total" type="string" calculate="number( /data/g_rev/phq2_1 ) + number( /data/g_rev/phq2_2 )"/>
      <bind nodeset="/data/g_rev/new_falls" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/medication_adherent" type="string" relevant=" /data/g_rev/alive  = 'yes'"/>
      <bind nodeset="/data/g_rev/caregiver_strain" type="string" relevant=" /data/g_rev/alive  = 'yes'" required="true()"/>
      <bind nodeset="/data/g_rev/review_result" type="string" calculate="if( /data/g_rev/alive  = 'no', 'deceased', if( /data/g_rev/ad8_total  &gt;= 2 or  /data/g_rev/phq2_total  &gt;= 3 or  /data/g_rev/caregiver_reported_trend  = 'worse', 're_refer', 'stable'))"/>
      <bind nodeset="/data/g_rev/review_notes" type="string" relevant=" /data/g_rev/alive  = 'yes'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/patient_name , ' - Review - ',  /data/g_rev/review_result )"/>
    </model>
