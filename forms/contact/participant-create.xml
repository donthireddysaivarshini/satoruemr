<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>New Participant</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="contact:participant:create" version="2026-08-20 00-00" prefix="J1!contact:participant:create!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <user>
              <contact_id/>
              <facility_id/>
              <name/>
            </user>
          </inputs>
          <participant>
            <parent>PARENT</parent>
            <type>participant</type>
            <registration_date/>
            <ward_dept_no/>
            <hospital_name/>
            <name/>
            <cr_no/>
            <aadhaar_last4/>
            <age/>
            <gender/>
            <education_level/>
            <occupation/>
            <phone/>
            <address/>
            <referral_department/>
            <referred_by/>
            <referral_complaint/>
            <notes/>
          </participant>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="gender_list">
        <root>
          <item>
            <name>male</name>
            <label>Male</label>
          </item>
          <item>
            <name>female</name>
            <label>Female</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="false()"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/participant/parent" type="string"/>
      <bind nodeset="/data/participant/type" type="string"/>
      <bind nodeset="/data/participant/registration_date" type="date" required="true()"/>
      <setvalue ref="/data/participant/registration_date" value="today()" event="odk-instance-first-load"/>
      <bind nodeset="/data/participant/ward_dept_no" type="string" required="true()"/>
      <bind nodeset="/data/participant/hospital_name" type="string" required="true()"/>
      <bind nodeset="/data/participant/name" type="string" required="true()"/>
      <bind nodeset="/data/participant/cr_no" type="string" required="true()"/>
      <bind nodeset="/data/participant/aadhaar_last4" type="string" required="true()"/>
      <bind nodeset="/data/participant/age" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 130" jr:constraintMsg="Age must be between 0 and 130"/>
      <bind nodeset="/data/participant/gender" type="string" required="true()"/>
      <bind nodeset="/data/participant/education_level" type="string"/>
      <bind nodeset="/data/participant/occupation" type="string"/>
      <bind nodeset="/data/participant/phone" type="tel" constraint="true()" jr:constraintMsg="Please enter a valid phone number."/>
      <bind nodeset="/data/participant/address" type="string"/>
      <bind nodeset="/data/participant/referral_department" type="string"/>
      <bind nodeset="/data/participant/referred_by" type="string"/>
      <bind nodeset="/data/participant/referral_complaint" type="string"/>
      <bind nodeset="/data/participant/notes" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/user/contact_id">
          <label>NO_LABEL</label>
        </input>
        <input ref="/data/inputs/user/facility_id">
          <label>NO_LABEL</label>
        </input>
        <input ref="/data/inputs/user/name">
          <label>NO_LABEL</label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/participant">
      <label>Patient Registration</label>
      <input ref="/data/participant/registration_date">
        <label>Date</label>
      </input>
      <input ref="/data/participant/ward_dept_no">
        <label>Ward / Dept No</label>
      </input>
      <input ref="/data/participant/hospital_name">
        <label>Hospital Name</label>
      </input>
      <input ref="/data/participant/name">
        <label>Patient Name</label>
      </input>
      <input ref="/data/participant/cr_no">
        <label>CR (Case Record) No.</label>
        <hint>Check for an existing participant with this CR No. before creating a new one to avoid duplicates.</hint>
      </input>
      <input ref="/data/participant/aadhaar_last4">
        <label>Aadhaar (last 4 digits)</label>
      </input>
      <input ref="/data/participant/age">
        <label>Age</label>
      </input>
      <select1 ref="/data/participant/gender">
        <label>Sex</label>
        <itemset nodeset="instance('gender_list')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/participant/education_level">
        <label>Education</label>
      </input>
      <input ref="/data/participant/occupation">
        <label>Occupation</label>
      </input>
      <input ref="/data/participant/phone">
        <label>Phone (patient / caregiver / attendant)</label>
      </input>
      <input ref="/data/participant/address">
        <label>Address / Locality - City / Town / Village / District</label>
      </input>
      <input ref="/data/participant/referral_department">
        <label>Department (referral)</label>
      </input>
      <input ref="/data/participant/referred_by">
        <label>Referred by (doctor name)</label>
      </input>
      <input ref="/data/participant/referral_complaint">
        <label>Health complaint &amp; reason for referral</label>
      </input>
      <input ref="/data/participant/notes" appearance="multiline">
        <label>Notes</label>
      </input>
    </group>
  </h:body>
</h:html>