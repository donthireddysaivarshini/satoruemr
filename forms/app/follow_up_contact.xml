      <instance>
        <data id="follow_up_contact" version="2026-07-29 00-00" prefix="J1!follow_up_contact!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <contact_id/>
              <name/>
            </user>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
              <age/>
              <gender/>
              <phone/>
              <education_level/>
              <consent_given/>
              <informant_name/>
              <informant_phone/>
            </contact>
          </inputs>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_sex/>
          <patient_age/>
          <patient_phone/>
          <patient_education/>
          <screened_by/>
          <screened_by_name/>
          <g_fu>
            <attempt_number>1</attempt_number>
            <contact_date/>
            <contact_mode/>
            <outcome/>
            <barriers/>
            <appointment_date/>
            <appointment_location/>
            <date_of_death/>
            <new_phone/>
            <notes/>
          </g_fu>
          <g_next>
            <closes_case/>
            <follow_up_status/>
            <closing_note/>
          </g_next>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
