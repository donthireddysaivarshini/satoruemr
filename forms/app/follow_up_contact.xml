      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/age" type="string"/>
      <bind nodeset="/data/inputs/contact/gender" type="string"/>
      <bind nodeset="/data/inputs/contact/phone" type="string"/>
      <bind nodeset="/data/inputs/contact/education_level" type="string"/>
      <bind nodeset="/data/inputs/contact/consent_given" type="string"/>
      <bind nodeset="/data/inputs/contact/informant_name" type="string"/>
      <bind nodeset="/data/inputs/contact/informant_phone" type="string"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/gender"/>
      <bind nodeset="/data/patient_age" type="string" calculate="../inputs/contact/age"/>
      <bind nodeset="/data/patient_phone" type="string" calculate="../inputs/contact/phone"/>
      <bind nodeset="/data/patient_education" type="string" calculate="../inputs/contact/education_level"/>
      <bind nodeset="/data/screened_by" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/screened_by_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/g_fu/attempt_number" type="int" constraint=". &gt;= 1 and . &lt;= 10" required="true()"/>
      <bind nodeset="/data/g_fu/contact_date" type="date" required="true()"/>
      <setvalue ref="/data/g_fu/contact_date" value="today()" event="odk-instance-first-load"/>
      <bind nodeset="/data/g_fu/contact_mode" type="string" required="true()"/>
      <bind nodeset="/data/g_fu/outcome" type="string" required="true()"/>
      <bind nodeset="/data/g_fu/barriers" type="string" relevant="selected( /data/g_fu/outcome , 'will_think') or selected( /data/g_fu/outcome , 'refused') or selected( /data/g_fu/outcome , 'unwell')"/>
      <bind nodeset="/data/g_fu/appointment_date" type="date" relevant=" /data/g_fu/outcome  = 'scheduled'" constraint=". &gt;= today()" jr:constraintMsg="jr:itext('/data/g_fu/appointment_date:jr:constraintMsg')" required="true()"/>
      <bind nodeset="/data/g_fu/appointment_location" type="string" relevant=" /data/g_fu/outcome  = 'scheduled'" required="true()"/>
      <bind nodeset="/data/g_fu/date_of_death" type="date" relevant=" /data/g_fu/outcome  = 'deceased'"/>
      <bind nodeset="/data/g_fu/new_phone" type="string" relevant=" /data/g_fu/outcome  = 'wrong_number'"/>
      <bind nodeset="/data/g_fu/notes" type="string"/>
      <bind nodeset="/data/g_next/closes_case" type="string" calculate="if( /data/g_fu/outcome  = 'refused' or  /data/g_fu/outcome  = 'deceased' or  /data/g_fu/outcome  = 'moved' or  /data/g_fu/outcome  = 'done_elsewhere' or  /data/g_fu/attempt_number  &gt;= 3, 'yes', 'no')"/>
      <bind nodeset="/data/g_next/follow_up_status" type="string" calculate="if( /data/g_fu/outcome  = 'scheduled', 'scheduled', if( /data/g_next/closes_case  = 'yes', 'closed', 'pending'))"/>
      <bind nodeset="/data/g_next/closing_note" readonly="true()" type="string" relevant=" /data/g_next/closes_case  = 'yes'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/patient_name , ' - Follow-up - ',  /data/g_fu/outcome )"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <group appearance="field-list" ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
      </group>
      <group appearance="field-list" ref="/data/inputs/contact">
        <label ref="jr:itext('/data/inputs/contact:label')"/>
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-participant">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_fu">
      <label ref="jr:itext('/data/g_fu:label')"/>
      <input ref="/data/g_fu/attempt_number">
        <label ref="jr:itext('/data/g_fu/attempt_number:label')"/>
      </input>
      <input ref="/data/g_fu/contact_date">
        <label ref="jr:itext('/data/g_fu/contact_date:label')"/>
      </input>
      <select1 ref="/data/g_fu/contact_mode">
        <label ref="jr:itext('/data/g_fu/contact_mode:label')"/>
        <itemset nodeset="instance('mode')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/g_fu/outcome">
        <label ref="jr:itext('/data/g_fu/outcome:label')"/>
        <itemset nodeset="instance('outcome')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select ref="/data/g_fu/barriers">
        <label ref="jr:itext('/data/g_fu/barriers:label')"/>
        <itemset nodeset="instance('barrier')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/g_fu/appointment_date">
        <label ref="jr:itext('/data/g_fu/appointment_date:label')"/>
      </input>
      <input ref="/data/g_fu/appointment_location">
        <label ref="jr:itext('/data/g_fu/appointment_location:label')"/>
      </input>
      <input ref="/data/g_fu/date_of_death">
        <label ref="jr:itext('/data/g_fu/date_of_death:label')"/>
      </input>
      <input ref="/data/g_fu/new_phone">
        <label ref="jr:itext('/data/g_fu/new_phone:label')"/>
      </input>
      <input ref="/data/g_fu/notes">
        <label ref="jr:itext('/data/g_fu/notes:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_next">
      <label ref="jr:itext('/data/g_next:label')"/>
      <input ref="/data/g_next/closing_note">
        <label ref="jr:itext('/data/g_next/closing_note:label')"/>
      </input>
    </group>
  </h:body>
</h:html>