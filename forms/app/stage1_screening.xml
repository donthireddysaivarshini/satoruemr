        </itemset>
      </select1>
      <input ref="/data/g_context/age_confirm">
        <label ref="jr:itext('/data/g_context/age_confirm:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_pmis">
      <label ref="jr:itext('/data/g_pmis:label')"/>
      <input ref="/data/g_pmis/pmis_instructions">
        <label ref="jr:itext('/data/g_pmis/pmis_instructions:label')"/>
      </input>
      <input ref="/data/g_pmis/pmis_free_recall">
        <label ref="jr:itext('/data/g_pmis/pmis_free_recall:label')"/>
      </input>
      <input ref="/data/g_pmis/pmis_cued_recall">
        <label ref="jr:itext('/data/g_pmis/pmis_cued_recall:label')"/>
        <hint ref="jr:itext('/data/g_pmis/pmis_cued_recall:hint')"/>
      </input>
      <input ref="/data/g_pmis/pmis_result">
        <label ref="jr:itext('/data/g_pmis/pmis_result:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_symbol">
      <label ref="jr:itext('/data/g_symbol:label')"/>
      <input ref="/data/g_symbol/symbol_instructions">
        <label ref="jr:itext('/data/g_symbol/symbol_instructions:label')"/>
      </input>
      <input ref="/data/g_symbol/symbol_correct">
        <label ref="jr:itext('/data/g_symbol/symbol_correct:label')"/>
      </input>
      <select1 ref="/data/g_symbol/symbol_completed">
        <label ref="jr:itext('/data/g_symbol/symbol_completed:label')"/>
        <itemset nodeset="instance('yesno')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/g_mcr">
      <label ref="jr:itext('/data/g_mcr:label')"/>
      <select1 ref="/data/g_mcr/scc_memory_complaint">
        <label ref="jr:itext('/data/g_mcr/scc_memory_complaint:label')"/>
        <itemset nodeset="instance('yesno')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/g_mcr/existing_dementia_dx">
        <label ref="jr:itext('/data/g_mcr/existing_dementia_dx:label')"/>
        <itemset nodeset="instance('yesno')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/g_mcr/mobility_disability">
        <label ref="jr:itext('/data/g_mcr/mobility_disability:label')"/>
        <itemset nodeset="instance('yesno')/root/item">
          <value ref="name"/>
