      <bind nodeset="/data/inputs/contact/phone" type="string"/>
      <bind nodeset="/data/inputs/contact/education_level" type="string"/>
      <bind nodeset="/data/inputs/contact/consent_given" type="string"/>
      <bind nodeset="/data/inputs/contact/informant_name" type="string"/>
      <bind nodeset="/data/inputs/contact/informant_phone" type="string"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/gender"/>
      <bind nodeset="/data/patient_age" type="string" calculate="../inputs/contact/age"/>
      <bind nodeset="/data/patient_phone" type="string" calculate="../inputs/contact/phone"/>
      <bind nodeset="/data/patient_education" type="string" calculate="../inputs/contact/education_level"/>
      <bind nodeset="/data/screened_by" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/screened_by_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/protocol/k_pmis_cutoff" type="string" calculate="4"/>
      <bind nodeset="/data/protocol/k_symbol_cutoff" type="string" calculate="10"/>
      <bind nodeset="/data/protocol/k_slow_gait_mps" type="string" calculate="0.8"/>
      <bind nodeset="/data/protocol/k_gait_distance_m" type="string" calculate="4"/>
      <bind nodeset="/data/g_consent/consent_script" readonly="true()" type="string"/>
      <bind nodeset="/data/g_consent/consent_confirmed" type="string" required="true()"/>
      <bind nodeset="/data/g_consent/consent_datetime" type="string" calculate="now()"/>
      <bind nodeset="/data/g_consent/consent_declined" readonly="true()" type="string" relevant=" /data/g_consent/consent_confirmed  = 'no'"/>
      <bind nodeset="/data/g_context" relevant=" /data/g_consent/consent_confirmed  = 'yes'"/>
      <bind nodeset="/data/g_context/screening_date" type="date" required="true()"/>
      <setvalue ref="/data/g_context/screening_date" value="today()" event="odk-instance-first-load"/>
      <bind nodeset="/data/g_context/setting" type="string" required="true()"/>
      <bind nodeset="/data/g_context/camp_code" type="string"/>
      <bind nodeset="/data/g_context/education_confirm" type="string" required="true()"/>
      <bind nodeset="/data/g_context/age_confirm" type="int" constraint=". &gt;= 40 and . &lt;= 120" jr:constraintMsg="jr:itext('/data/g_context/age_confirm:jr:constraintMsg')" required="true()"/>
      <bind nodeset="/data/g_pmis" relevant=" /data/g_consent/consent_confirmed  = 'yes'"/>
      <bind nodeset="/data/g_pmis/pmis_instructions" readonly="true()" type="string"/>
      <bind nodeset="/data/g_pmis/pmis_free_recall" type="int" constraint=". &gt;= 0 and . &lt;= 4" jr:constraintMsg="jr:itext('/data/g_pmis/pmis_free_recall:jr:constraintMsg')" required="true()"/>
      <bind nodeset="/data/g_pmis/pmis_cued_recall" type="int" constraint=". &gt;= 0 and . &lt;= 4 and (. +  /data/g_pmis/pmis_free_recall ) &lt;= 4" jr:constraintMsg="jr:itext('/data/g_pmis/pmis_cued_recall:jr:constraintMsg')" required="true()"/>
      <bind nodeset="/data/g_pmis/pmis_score" type="string" calculate="(2 *  /data/g_pmis/pmis_free_recall ) +  /data/g_pmis/pmis_cued_recall "/>
      <bind nodeset="/data/g_pmis/pmis_flag" type="string" calculate="if( /data/g_pmis/pmis_score  &lt;=  /data/protocol/k_pmis_cutoff , 1, 0)"/>
      <bind nodeset="/data/g_pmis/pmis_result" readonly="true()" type="string"/>
      <bind nodeset="/data/g_symbol" relevant=" /data/g_consent/consent_confirmed  = 'yes'"/>
      <bind nodeset="/data/g_symbol/symbol_instructions" readonly="true()" type="string"/>
      <bind nodeset="/data/g_symbol/symbol_correct" type="int" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="jr:itext('/data/g_symbol/symbol_correct:jr:constraintMsg')" required="true()"/>
      <bind nodeset="/data/g_symbol/symbol_completed" type="string" required="true()"/>
      <bind nodeset="/data/g_symbol/symbol_flag" type="string" calculate="if( /data/g_symbol/symbol_completed  = 'no', 1, if( /data/g_symbol/symbol_correct  &lt;=  /data/protocol/k_symbol_cutoff , 1, 0))"/>
      <bind nodeset="/data/g_mcr" relevant=" /data/g_consent/consent_confirmed  = 'yes'"/>
      <bind nodeset="/data/g_mcr/scc_memory_complaint" type="string" required="true()"/>
      <bind nodeset="/data/g_mcr/existing_dementia_dx" type="string" required="true()"/>
      <bind nodeset="/data/g_mcr/mobility_disability" type="string" required="true()"/>
      <bind nodeset="/data/g_mcr/gait_time_sec" type="decimal" relevant=" /data/g_mcr/mobility_disability  = 'no'" constraint=". &gt; 0 and . &lt; 120" jr:constraintMsg="jr:itext('/data/g_mcr/gait_time_sec:jr:constraintMsg')" required="true()"/>
      <bind nodeset="/data/g_mcr/gait_speed_mps" type="string" calculate="if( /data/g_mcr/mobility_disability  = 'yes', 0, round( /data/protocol/k_gait_distance_m  div  /data/g_mcr/gait_time_sec , 2))"/>
      <bind nodeset="/data/g_mcr/slow_gait_flag" type="string" calculate="if( /data/g_mcr/gait_speed_mps  &lt;  /data/protocol/k_slow_gait_mps , 1, 0)"/>
      <bind nodeset="/data/g_mcr/mcr_positive" type="string" calculate="if( /data/g_mcr/scc_memory_complaint  = 'yes' and  /data/g_mcr/slow_gait_flag  = 1 and  /data/g_mcr/existing_dementia_dx  = 'no' and  /data/g_mcr/mobility_disability  = 'no', 1, 0)"/>
      <bind nodeset="/data/g_mcr/mcr_result" readonly="true()" type="string"/>
      <bind nodeset="/data/g_outcome" relevant=" /data/g_consent/consent_confirmed  = 'yes'"/>
      <bind nodeset="/data/g_outcome/stage1_flag_count" type="string" calculate=" /data/g_pmis/pmis_flag  +  /data/g_symbol/symbol_flag  +  /data/g_mcr/mcr_positive "/>
      <bind nodeset="/data/g_outcome/stage1_result" type="string" calculate="if( /data/g_mcr/existing_dementia_dx  = 'yes', 'known_dementia', if( /data/g_outcome/stage1_flag_count  &gt;= 1, 'refer', 'normal'))"/>
      <bind nodeset="/data/g_outcome/stage2_same_day" type="string" relevant=" /data/g_outcome/stage1_result  = 'refer'" required="true()"/>
      <bind nodeset="/data/g_outcome/informant_available" type="string" relevant=" /data/g_outcome/stage1_result  = 'refer'" required="true()"/>
      <bind nodeset="/data/g_outcome/result_normal" readonly="true()" type="string" relevant=" /data/g_outcome/stage1_result  = 'normal'"/>
      <bind nodeset="/data/g_outcome/result_refer" readonly="true()" type="string" relevant=" /data/g_outcome/stage1_result  = 'refer'"/>
      <bind nodeset="/data/g_outcome/screener_notes" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/patient_name , ' - Stage 1 - ',  /data/g_outcome/stage1_result )"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
