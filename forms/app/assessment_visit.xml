<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Assessment Visit</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="assessment_visit" version="2026-08-20 02-00" prefix="J1!assessment_visit!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <contact_id/>
              <name/>
            </user>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
              <age/>
              <gender/>
              <phone/>
              <education_level/>
              <cr_no/>
            </contact>
          </inputs>
          <patient_id/>
          <patient_name/>
          <patient_sex/>
          <patient_age/>
          <patient_phone/>
          <patient_education/>
          <patient_cr_no/>
          <screened_by_name/>
          <g_patient>
            <patient_name_confirm/>
            <patient_cr_confirm/>
          </g_patient>
          <g_consent>
            <consent_mode/>
            <consent_given/>
            <consent_recorded_at/>
            <consent_version/>
            <consent_docs jr:template="">
              <consent_image type="binary"/>
              <consent_pdf type="binary"/>
            </consent_docs>
          </g_consent>
          <g_informant>
            <informant_name/>
            <informant_phone/>
          </g_informant>
          <g_assessment>
            <assessment_datetime/>
            <administered_by/>
            <g_scale jr:template="">
              <scale_name/>
              <score/>
              <interpretation/>
            </g_scale>
          </g_assessment>
          <g_clinical>
            <clinical_impression/>
          </g_clinical>
          <g_followup>
            <next_visit_date/>
            <notes/>
            <notes_docs jr:template="">
              <notes_image type="binary"/>
              <notes_pdf type="binary"/>
            </notes_docs>
            <assessed_by/>
            <reviewed_by/>
          </g_followup>
          <g_office>
            <entered_in_cht/>
            <qc_checked_by/>
            <record_id/>
            <qc_check_date/>
          </g_office>
          <g_assessment_sheets>
            <assessment_sheets jr:template="">
              <assessment_image type="binary"/>
              <assessment_pdf type="binary"/>
            </assessment_sheets>
          </g_assessment_sheets>
          <g_supporting_docs>
            <upload_scale_image/>
            <upload_scale_pdf/>
            <upload_caption/>
          </g_supporting_docs>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="consent_mode_list">
        <root>
          <item>
            <name>written</name>
            <label>Written</label>
          </item>
          <item>
            <name>verbal</name>
            <label>Verbal</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/age" type="string"/>
      <bind nodeset="/data/inputs/contact/gender" type="string"/>
      <bind nodeset="/data/inputs/contact/phone" type="string"/>
      <bind nodeset="/data/inputs/contact/education_level" type="string"/>
      <bind nodeset="/data/inputs/contact/cr_no" type="string"/>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/gender"/>
      <bind nodeset="/data/patient_age" type="string" calculate="../inputs/contact/age"/>
      <bind nodeset="/data/patient_phone" type="string" calculate="../inputs/contact/phone"/>
      <bind nodeset="/data/patient_education" type="string" calculate="../inputs/contact/education_level"/>
      <bind nodeset="/data/patient_cr_no" type="string" calculate="../inputs/contact/cr_no"/>
      <bind nodeset="/data/screened_by_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/g_patient/patient_name_confirm" type="string" required="true()"/>
      <bind nodeset="/data/g_patient/patient_cr_confirm" type="string" required="true()"/>
      <bind nodeset="/data/g_consent/consent_mode" type="string" required="true()"/>
      <bind nodeset="/data/g_consent/consent_given" type="string" required="true()"/>
      <bind nodeset="/data/g_consent/consent_recorded_at" type="string" calculate="now()"/>
      <bind nodeset="/data/g_consent/consent_version" type="string" calculate="'SATORU-CONSENT-v1.0-2026'"/>
      <bind nodeset="/data/g_consent/consent_docs/consent_image" type="binary"/>
      <bind nodeset="/data/g_consent/consent_docs/consent_pdf" type="binary"/>
      <bind nodeset="/data/g_informant/informant_name" type="string" required="true()"/>
      <bind nodeset="/data/g_informant/informant_phone" type="tel" required="true()" constraint="true()" jr:constraintMsg="Please enter a valid phone number."/>
      <bind nodeset="/data/g_assessment/assessment_datetime" type="dateTime" required="true()"/>
      <setvalue ref="/data/g_assessment/assessment_datetime" value="now()" event="odk-instance-first-load"/>
      <bind nodeset="/data/g_assessment/administered_by" type="string" required="true()"/>
      <bind nodeset="/data/g_assessment/g_scale/scale_name" type="string" required="true()"/>
      <bind nodeset="/data/g_assessment/g_scale/score" type="string" required="true()"/>
      <bind nodeset="/data/g_assessment/g_scale/interpretation" type="string" required="true()"/>
      <bind nodeset="/data/g_clinical/clinical_impression" type="string" required="true()"/>
      <bind nodeset="/data/g_followup/next_visit_date" type="date" required="true()"/>
      <bind nodeset="/data/g_followup/notes" type="string"/>
      <bind nodeset="/data/g_followup/notes_docs/notes_image" type="binary"/>
      <bind nodeset="/data/g_followup/notes_docs/notes_pdf" type="binary"/>
      <bind nodeset="/data/g_followup/assessed_by" type="string" required="true()"/>
      <bind nodeset="/data/g_followup/reviewed_by" type="string" required="true()"/>
      <bind nodeset="/data/g_office/entered_in_cht" type="string" required="true()"/>
      <bind nodeset="/data/g_office/qc_checked_by" type="string" required="true()"/>
      <bind nodeset="/data/g_office/record_id" type="string" required="true()"/>
      <bind nodeset="/data/g_office/qc_check_date" type="date" required="true()"/>
      <bind nodeset="/data/g_assessment_sheets/assessment_sheets/assessment_image" type="binary"/>
      <bind nodeset="/data/g_assessment_sheets/assessment_sheets/assessment_pdf" type="binary"/>
      <bind nodeset="/data/g_supporting_docs/upload_scale_image" type="binary"/>
      <bind nodeset="/data/g_supporting_docs/upload_scale_pdf" type="binary"/>
      <bind nodeset="/data/g_supporting_docs/upload_caption" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group appearance="field-list" ref="/data/inputs/user">
        <label>NO_LABEL</label>
      </group>
      <group appearance="field-list" ref="/data/inputs/contact">
        <label>Participant</label>
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-participant">
          <label>Select participant</label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_patient">
      <label>Patient</label>
      <input ref="/data/g_patient/patient_name_confirm">
        <label>Patient Name</label>
      </input>
      <input ref="/data/g_patient/patient_cr_confirm">
        <label>CR (Case Record) No.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_consent">
      <label>Consent</label>
      <select1 ref="/data/g_consent/consent_mode">
        <label>Type of consent obtained</label>
        <itemset nodeset="instance('consent_mode_list')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/g_consent/consent_given">
        <label>Consent given for screening and data storage?</label>
        <hint>Explain purpose, confidentiality and the right to stop at any time.</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <group ref="/data/g_consent/consent_docs">
        <label>Consent form / document (upload)</label>
        <repeat nodeset="/data/g_consent/consent_docs" appearance="field-list">
          <upload ref="/data/g_consent/consent_docs/consent_image" mediatype="image/*">
            <label>Upload consent form / document (image)</label>
            <hint>Upload clear photo of consent form. Accepts JPG, JPEG, PNG.</hint>
          </upload>
          <upload ref="/data/g_consent/consent_docs/consent_pdf" mediatype="application/*">
            <label>Upload consent form / document (PDF)</label>
            <hint>Upload PDF of consent form. Accepts PDF.</hint>
          </upload>
        </repeat>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_informant">
      <label>Informant</label>
      <input ref="/data/g_informant/informant_name">
        <label>Respondent name &amp; relation</label>
      </input>
      <input ref="/data/g_informant/informant_phone">
        <label>Informant phone number</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_assessment">
      <label>Assessment</label>
      <input ref="/data/g_assessment/assessment_datetime">
        <label>Date &amp; time of assessment</label>
      </input>
      <input ref="/data/g_assessment/administered_by">
        <label>Administered by (staff name/s)</label>
      </input>
      <group ref="/data/g_assessment/g_scale">
        <label>Assessment scales used (record each separately)</label>
        <repeat nodeset="/data/g_assessment/g_scale" appearance="field-list">
          <input ref="/data/g_assessment/g_scale/scale_name">
            <label>Assessment scale used</label>
          </input>
          <input ref="/data/g_assessment/g_scale/score">
            <label>Score / result</label>
          </input>
          <input ref="/data/g_assessment/g_scale/interpretation">
            <label>Interpretation</label>
          </input>
        </repeat>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_clinical">
      <label>Clinical impression</label>
      <input ref="/data/g_clinical/clinical_impression" appearance="multiline">
        <label>Provisional diagnosis (post-assessment) / Clinical impression</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_followup">
      <label>Follow-up &amp; notes</label>
      <input ref="/data/g_followup/next_visit_date">
        <label>Follow-up / next visit date</label>
      </input>
      <input ref="/data/g_followup/notes" appearance="multiline">
        <label>Notes</label>
        <hint>Type your notes here, or upload a notes image below.</hint>
      </input>
      <group ref="/data/g_followup/notes_docs">
        <label>Notes upload</label>
        <repeat nodeset="/data/g_followup/notes_docs" appearance="field-list">
          <upload ref="/data/g_followup/notes_docs/notes_image" mediatype="image/*">
            <label>Upload notes image</label>
            <hint>Upload clear photo of notes. Accepts JPG, JPEG, PNG.</hint>
          </upload>
          <upload ref="/data/g_followup/notes_docs/notes_pdf" mediatype="application/*">
            <label>Upload notes document (PDF)</label>
            <hint>Upload PDF of notes. Accepts PDF.</hint>
          </upload>
        </repeat>
      </group>
      <input ref="/data/g_followup/assessed_by">
        <label>Assessed by (staff - name &amp; signature)</label>
      </input>
      <input ref="/data/g_followup/reviewed_by">
        <label>Reviewed by (staff - name &amp; signature)</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_office">
      <label>For office use only (not part of clinical assessment)</label>
      <select1 ref="/data/g_office/entered_in_cht">
        <label>Entered in Kobo / CHT</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/g_office/qc_checked_by">
        <label>Quality control - checked by (name)</label>
      </input>
      <input ref="/data/g_office/record_id">
        <label>Participant kobo / Record ID</label>
      </input>
      <input ref="/data/g_office/qc_check_date">
        <label>Quality control checking date</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_assessment_sheets">
      <label>Assessment sheet</label>
      <group ref="/data/g_assessment_sheets/assessment_sheets">
        <label>Assessment sheet upload</label>
        <repeat nodeset="/data/g_assessment_sheets/assessment_sheets" appearance="field-list">
          <upload ref="/data/g_assessment_sheets/assessment_sheets/assessment_image" mediatype="image/*">
            <label>Upload assessment sheet (image)</label>
            <hint>Upload clear photo of assessment sheet. Accepts JPG, JPEG, PNG.</hint>
          </upload>
          <upload ref="/data/g_assessment_sheets/assessment_sheets/assessment_pdf" mediatype="application/*">
            <label>Upload assessment sheet (PDF)</label>
            <hint>Upload PDF of assessment sheet. Accepts PDF.</hint>
          </upload>
        </repeat>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_supporting_docs">
      <label>Supporting Documents / Scale Upload</label>
      <upload ref="/data/g_supporting_docs/upload_scale_image" mediatype="image/*">
        <label>Upload completed scale / assessment sheet (image)</label>
        <hint>Upload clear photos of the completed paper scale, consent form, or supporting assessment document. Accepts JPG, JPEG, PNG. For PDF use next field.</hint>
      </upload>
      <upload ref="/data/g_supporting_docs/upload_scale_pdf" mediatype="application/*">
        <label>Upload completed scale / assessment sheet (PDF)</label>
        <hint>Upload a PDF of the completed paper scale if not already uploaded as image. Accepts PDF.</hint>
      </upload>
      <input ref="/data/g_supporting_docs/upload_caption">
        <label>Attachment caption / description (optional)</label>
      </input>
    </group>
  </h:body>
</h:html>